        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.tollgate.owner"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "tollgate",
    "extra": {
      "engine": "0x8168eb562496A966f339a4bD165B924EeDce9873",
      "owner": "0x8dEa7F60FB144Ea127F6806302E6a83913348B69"
