    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tollgate.owner"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
