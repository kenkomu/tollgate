{
  "name": "tollgate",
  "version": "0.0.0",
  "private": true,
  "description": "An enforcement layer for autonomous agent spending, on Arc.",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "contracts:build": "cd enforcement && forge build",
    "contracts:test": "cd enforcement && forge test -vv",
    "contracts:invariant": "cd enforcement && forge test --match-path 'test/invariant/*' -vv",
    "contracts:fmt": "cd enforcement && forge fmt",
    "dashboard": "pnpm --filter @tollgate/dashboard dev",
    "agent": "pnpm --filter @tollgate/agent demo",
    "agent:compromised": "pnpm --filter @tollgate/agent compromised",
    "balances": "pnpm --filter @tollgate/agent balances",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:all": "pnpm contracts:test && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.10.2"
  }
}
