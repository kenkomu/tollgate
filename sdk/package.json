{
  "name": "@tollgate/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Give any AI agent a wallet it cannot overspend. Client, framework-neutral tools, an MCP server and a Glove adapter for Tollgate on Arc.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./glove": "./src/glove.ts",
    "./mcp": "./src/mcp.ts"
  },
  "bin": {
    "tollgate-mcp": "./src/mcp-server.ts"
  },
  "scripts": {
    "mcp": "node --env-file=../.env src/mcp-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tollgate/shared": "workspace:*",
    "viem": "^2.55.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "~6.0.3"
  }
}
