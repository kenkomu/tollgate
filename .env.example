# Copy to .env and fill in. Never commit .env — testnet keys are still keys.

# ---- Arc testnet ----
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER=https://testnet.arcscan.app

# ---- Arc mainnet (real USDC — use a throwaway deployer, small budgets) ----
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# ARC_CHAIN_ID=5042
# ARC_EXPLORER=https://explorer.arc.io
# CONFIRM_MAINNET=true   # required by Deploy.s.sol on chain 5042

# USDC ERC-20 interface predeploy (6 decimals). Native gas USDC is 18 — do not mix.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ---- deployment ----
# Deployer for PolicyEngine. Fund from https://faucet.circle.com (select Arc Testnet).
DEPLOYER_PRIVATE_KEY=
POLICY_ENGINE_ADDRESS=

# ---- the demo agent's session key ----
# This is the key we leak on camera. It must never hold anything but gas.
AGENT_PRIVATE_KEY=

# ---- Circle ----
# Console: https://console.circle.com
CIRCLE_API_KEY=
CIRCLE_CLIENT_KEY=
CIRCLE_CLIENT_URL=

# ---- service ----
DATABASE_URL=postgres://localhost:5432/tollgate
REDIS_URL=redis://localhost:6379
PORT=8080
